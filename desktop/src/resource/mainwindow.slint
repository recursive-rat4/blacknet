import { TabWidget } from "std-widgets.slint";
import { DashboardBox } from "dashboardbox.slint";
import { HistoryView } from "historyview.slint";
import { PeersBox } from "peersbox.slint";
import { StakingBox, StakingInfo } from "stakingbox.slint";
import { TransferBox } from "transferbox.slint";

export component MainWindow inherits Window {
    title: @tr("Blacknet");
    preferred-width: 950px;
    preferred-height: 550px;

    in property <StakingInfo> staking-info;
    in property <[string]> wallets;
    in-out property <int> current-wallet: -1;
    in property <[[StandardListViewItem]]> history;
    in property <[[StandardListViewItem]]> peers;

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("Quit");
                activated => { quit(); }
                shortcut: @keys(Control + Q);
            }
        }
        Menu {
            title: @tr("Wallet");
            MenuItem {
                title: @tr("Create");
                activated => { create-wallet(); }
            }
            MenuSeparator {}
            for wallet[index] in root.wallets : MenuItem {
                title: wallet;
                checked: index == root.current-wallet;
                activated => {
                    if index != root.current-wallet {
                        root.current-wallet = index;
                        switch-wallet(wallet);
                    }
                }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("About");
                activated => { about(); }
            }
        }
    }

    TabWidget {
        orientation: Orientation.vertical;
        Tab {
            title: @tr("Dashboard");
            DashboardBox {}
        }
        Tab {
            title: @tr("Transfer");
            TransferBox {}
        }
        Tab {
            title: @tr("History");
            HistoryView {
                width: parent.width;
                height: parent.height;
                rows: root.history;
                sort-ascending(column) => root.sort-history-ascending(column);
                sort-descending(column) => root.sort-history-descending(column);
            }
        }
        Tab {
            title: @tr("Staking");
            StakingBox {
                info: root.staking-info;
            }
        }
        Tab {
            title: @tr("Peers");
            PeersBox {
                peers: root.peers;
                connect-peer(addr, port) => root.connect-peer(addr, port);
                disconnect-peer(idx) => root.disconnect-peer(idx);
                sort-ascending(column) => root.sort-peers-ascending(column);
                sort-descending(column) => root.sort-peers-descending(column);
            }
        }
    }

    callback create-wallet();
    callback switch-wallet(string);
    callback connect-peer(string, int);
    callback disconnect-peer(int);
    callback sort-history-ascending(int);
    callback sort-history-descending(int);
    callback sort-peers-ascending(int);
    callback sort-peers-descending(int);
    callback about();
    callback quit();
}
