import { TabWidget } from "std-widgets.slint";
import { DashboardBox } from "dashboardbox.slint";
import { HistoryView } from "historyview.slint";
import { StakingBox } from "stakingbox.slint";
import { TransferBox } from "transferbox.slint";

export component MainWindow inherits Window {
    title: "Blacknet";
    preferred-width: 950px;
    preferred-height: 550px;

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Quit";
                activated => { quit(); }
                shortcut: @keys(Control + Q);
            }
        }
    }

    TabWidget {
        orientation: Orientation.vertical;
        Tab {
            title: "Dashboard";
            DashboardBox {}
        }
        Tab {
            title: "Transfer";
            TransferBox {}
        }
        Tab {
            title: "History";
            HistoryView {
                width: parent.width;
                height: parent.height;
            }
        }
        Tab {
            title: "Staking";
            StakingBox {}
        }
    }

    callback quit();
}
