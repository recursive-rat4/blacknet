import {
    Button,
    HorizontalBox,
    LineEdit,
    StandardTableView,
    VerticalBox,
} from "std-widgets.slint";

export component PeersBox inherits VerticalBox {
    in property <[[StandardListViewItem]]> peers;

    table := StandardTableView {
        columns: [
            { title: @tr("Endpoint") },
            { title: @tr("User agent") },
            { title: @tr("Ping") },
            { title: @tr("Direction") },
            { title: @tr("Read") },
            { title: @tr("Written") },
        ];
        rows: parent.peers;
    }
    Rectangle {}
    VerticalBox {
        HorizontalBox {
            addr := LineEdit {
                Tooltip {
                    text: @markdown("Address");
                }
            }
            port := LineEdit {
                horizontal-stretch: 0;
                placeholder-text: "28453";
                input-type: number;
                Tooltip {
                    text: @markdown("Port");
                }
            }
            Button {
                horizontal-stretch: 0;
                text: @tr("Connect");
                enabled: !addr.text.is-empty;
                clicked => {
                    root.connect-peer(addr.text, port.text.to-float());
                }
            }
        }
        Button {
            text: @tr("Disconnect selected peer");
            enabled: table.current-row != -1;
            clicked => {
                root.disconnect-peer(table.current-row);
            }
        }
    }

    callback connect-peer(string, int);
    callback disconnect-peer(int);
}
