import {
    AboutSlint,
    HorizontalBox,
    TabWidget,
    StandardButton,
    VerticalBox,
} from "std-widgets.slint";

export component AboutDialog inherits Dialog {
    title: @tr("About");
    preferred-width: 780px;
    preferred-height: 400px;

    in property <string> version;

    TabWidget {
        Tab {
            title: @tr("Blacknet");
            HorizontalBox {
                alignment: start;
                cross-axis-alignment: start;
                Image {
                    source: @image-url("logo.png");
                    image-fit: preserve;
                }
                VerticalBox {
                    alignment: start;
                    StyledText {
                        text: @markdown("**Blacknet**");
                    }
                    Text {
                        text: @tr("Version {}", version);
                    }
                    Text {
                        text: @tr("Blacknet is a decentralized peer-to-peer network with the proof of stake cryptographic consensus.");
                    }
                    StyledText {
                        text: @markdown("Visit [https://blacknet.ninja](https://blacknet.ninja) for further information.");
                        link-clicked(link) => {
                            Platform.open-url(link);
                        }
                    }
                }
            }
        }
        Tab {
            title: @tr("GUI");
            AboutSlint {}
        }
    }
    StandardButton {
        kind: close;
        clicked => {
            root.close();
        }
    }
}
